{
  "name": "bullmq-cockpit",
  "version": "0.2.0",
  "description": "Modern dashboard and durable instance inspector for BullMQ.",
  "type": "module",
  "license": "MIT",
  "author": "elmer",
  "keywords": [
    "bullmq",
    "redis",
    "queue",
    "dashboard",
    "ui",
    "admin",
    "durable",
    "workflow",
    "monitoring",
    "hono"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "require": {
        "types": "./dist/adapters/express.d.cts",
        "default": "./dist/adapters/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "require": {
        "types": "./dist/adapters/fastify.d.cts",
        "default": "./dist/adapters/fastify.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/adapters/nestjs.d.ts",
        "default": "./dist/adapters/nestjs.js"
      },
      "require": {
        "types": "./dist/adapters/nestjs.d.cts",
        "default": "./dist/adapters/nestjs.cjs"
      }
    },
    "./standalone": {
      "import": {
        "types": "./dist/adapters/standalone.d.ts",
        "default": "./dist/adapters/standalone.js"
      },
      "require": {
        "types": "./dist/adapters/standalone.d.cts",
        "default": "./dist/adapters/standalone.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bullmq-cockpit": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "tsup",
    "build:client": "vite build",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch scripts/dev-server.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "tsup --watch",
    "seed": "tsx scripts/seed.ts",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "redis:reset": "docker compose down -v && docker compose up -d",
    "setup": "pnpm run redis:up && pnpm run seed",
    "demo": "pnpm run redis:up && pnpm run seed && pnpm run dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"client/src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@trpc/server": "^11.18.0",
    "bullmq": "^5.0.0",
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8",
    "bullmq-durable": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@heroui/react": "^2.8.10",
    "@heroui/theme": "^2.4.26",
    "@iconify/react": "^5.0.2",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@trpc/client": "^11.18.0",
    "@tanstack/react-router": "^1.87.0",
    "@tanstack/react-table": "^8.20.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bullmq-durable": "workspace:*",
    "concurrently": "^10.0.3",
    "eslint": "^9.11.1",
    "express": "^5.0.1",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.11"
  }
}