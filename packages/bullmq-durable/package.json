{
  "name": "bullmq-durable",
  "version": "0.1.2",
  "description": "Durable execution for BullMQ jobs. Checkpoint, retry, sleep, and resume long-running jobs with a simple step API.",
  "type": "module",
  "license": "MIT",
  "author": "elmer",
  "packageManager": "pnpm@11.3.0",
  "keywords": [
    "bullmq",
    "redis",
    "queue",
    "durable",
    "workflow",
    "durable-execution",
    "checkpoint",
    "saga",
    "nestjs",
    "job"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/nestjs/index.d.cts",
        "default": "./dist/nestjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"{src,test,examples}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,examples}/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "bullmq": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/testing": "^10.4.4",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.9",
    "bullmq": "^5.0.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
